# Copy to backend/.env and edit. Every value below is a default - the pipeline
# runs with no .env file at all.

# ---------- Core ----------
ECHONOTES_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ---------- Storage ----------
# Paths are relative to backend/
DATABASE_URL=sqlite:///./data/echonotes.db
AUDIO_RAW_DIR=./data/audio_raw
TRANSCRIPT_DIR=./data/transcripts

# ---------- Capture (Phase 1) ----------
# dummy      replays data/fixtures/sample_capture.wav - no hardware needed
# microphone records from the default input device (needs `pip install sounddevice`)
CAPTURE_SOURCE=dummy
DUMMY_AUDIO_PATH=./data/fixtures/sample_capture.wav
MAX_CAPTURE_SECONDS=300

# ---------- Speech to text (Phase 1) ----------
ASR_BACKEND=faster_whisper
# tiny | base | small | medium | large-v3  (larger = more accurate, slower)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Leave unset to auto-detect the spoken language
# WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true

# ---------- LLM (Phase 2 fallback) ----------
# Optional. With no key the pipeline runs on rules alone and never fails.
# anthropic | groq | null
#
# groq is the free option: no credit card. Get a key at
# https://console.groq.com/keys (sign in, "API Keys" -> "Create API Key"),
# then set:
#   LLM_PROVIDER=groq
#   LLM_MODEL=openai/gpt-oss-120b
#   GROQ_API_KEY=gsk_...
# (openai/gpt-oss-120b is Groq's free-tier model as of testing this -
# check https://console.groq.com/docs/deprecations if it ever 404s)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ---------- Understanding (Phase 2) ----------
# Below these confidences the rule result is treated as unreliable and the LLM
# fallback is consulted instead.
CLASSIFICATION_CONFIDENCE_FLOOR=0.55
EXTRACTION_CONFIDENCE_FLOOR=0.50
KEY_PHRASE_LIMIT=10

# ---------- Quality scoring (Phase 2) ----------
# Must sum to 1.0
QUALITY_WEIGHT_READABILITY=0.30
QUALITY_WEIGHT_COHERENCE=0.30
QUALITY_WEIGHT_TRANSCRIPTION=0.40
