# ---------- Core ----------
ECHONOTES_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ---------- Storage ----------
DATABASE_URL=sqlite:///./data/echonotes.db
CHROMA_DIR=./data/chroma
AUDIO_RAW_DIR=./data/audio_raw
AUDIO_PROCESSED_DIR=./data/audio_processed
TRANSCRIPT_DIR=./data/transcripts
IMAGE_DIR=./data/images

# ---------- LNT: audio (paper §3.3) ----------
# pydub normalization + split_on_silence arguments
AUDIO_TARGET_DBFS=-20.0
SILENCE_THRESH_DBFS=-40
MIN_SILENCE_LEN_MS=500
CHUNK_KEEP_SILENCE_MS=250

# ---------- LNT: ASR + translation (paper §3.2) ----------
# SpeechRecognition backend: google | whisper
ASR_BACKEND=google
ASR_DEFAULT_LANGUAGE=en-US
# LNT standardizes every language to English before analysis
TRANSLATE_TO=en

# ---------- LNT: NLP (paper §3.4) ----------
WORD2VEC_ALGORITHM=cbow        # cbow | skipgram  (paper §3.4.3)
WORD2VEC_VECTOR_SIZE=100
WORD2VEC_WINDOW=5
WORD2VEC_MIN_COUNT=1
SUMMARY_TOP_K=10               # first K ranked sentences (paper §3.4.5)
LDA_NUM_TOPICS=9               # paper's sample lecture yielded 9 themes
LDA_MAX_ITER=20

# ---------- LLM (cluster summaries, classification, RAG answers) ----------
# Idea11y used gpt-4o-mini for cluster summaries; provider is pluggable here.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------- Embeddings (RAG) ----------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------- OCR ----------
OCR_ENGINE=tesseract
TESSERACT_CMD=

# ---------- Accessibility ----------
CAPTURE_TRIGGER=spacebar       # spacebar | hotkey | gpio
TTS_ENGINE=web_speech          # web_speech (browser) | pyttsx3 (server)
